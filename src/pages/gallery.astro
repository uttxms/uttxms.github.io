---
import Base from '../layouts/Base.astro';
import PhotoTile from '../components/PhotoTile.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos, years } from '../data/photos';
---
<Base title="Gallery · Uttam Sharma" description="Photos from places I've been." footerLinks>
  <main class="page">
    <header>
      <a class="back" href="/">&larr; Uttam Sharma</a>
      <h1>Gallery</h1>
      {years.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by year">
          <button type="button" data-year="all" aria-pressed="true">All</button>
          {years.map((y) => <button type="button" data-year={y} aria-pressed="false">{y}</button>)}
        </div>
      )}
    </header>
    <div class="grid">
      {photos.map((p, n) => (
        <div class="cell" data-year={p.year}><PhotoTile photo={p} eager={n < 8} /></div>
      ))}
    </div>
  </main>
  <Lightbox />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cells = document.querySelectorAll<HTMLElement>('.cell');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      cells.forEach((c) => (c.hidden = b.dataset.year !== 'all' && c.dataset.year !== b.dataset.year));
    }),
  );
</script>

<style>
  .page { max-width: 1280px; margin: auto; padding: 8px 0 80px; }
  header { margin-bottom: 40px; }
  .back { color: var(--mute); text-decoration: none; }
  .back:hover { color: var(--ink); }
  h1 { font: 900 clamp(64px, 12vw, 160px)/.85 var(--display); text-transform: uppercase; margin: 18px 0 26px; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; }
  .filters button { font: 500 15px var(--body); color: var(--ink); background: none; border: 1.5px solid var(--line); border-radius: 99px; padding: 8px 18px; cursor: pointer; transition: background .2s, border-color .2s; }
  .filters button:hover { border-color: var(--red-bright); }
  .filters button[aria-pressed='true'] { background: var(--red); border-color: var(--red); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 18px; }
  .cell[hidden] { display: none; }
  @media (max-width: 560px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    header { margin-bottom: 28px; }
  }
</style>
