<dialog id="lightbox" aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close" data-lb="close">&times;</button>
  <button class="lb-nav prev" type="button" aria-label="Previous photo" data-lb="prev">&#8592;</button>
  <figure>
    <img alt="" />
    <figcaption><b></b><span></span><small></small></figcaption>
  </figure>
  <button class="lb-nav next" type="button" aria-label="Next photo" data-lb="next">&#8594;</button>
</dialog>

<style is:global>
  #lightbox { border: 0; padding: 0; background: transparent; color: var(--ink); width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; }
  #lightbox::backdrop { background: rgba(8, 2, 4, .94); }
  #lightbox[open] { display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; animation: lb-in .25s ease; }
  #lightbox figure { display: flex; flex-direction: column; align-items: center; gap: 14px; min-width: 0; }
  #lightbox img { max-width: 100%; max-height: calc(100vh - 120px); max-height: calc(100dvh - 120px); object-fit: contain; border-radius: 12px; }
  #lightbox figcaption { text-align: center; line-height: 1.3; }
  #lightbox figcaption b { display: block; font: 700 28px/1 var(--display); letter-spacing: .01em; }
  #lightbox figcaption small { display: block; margin-top: 6px; color: var(--mute); font-size: 13px; }
  body:has(#lightbox[open]) { overflow: hidden; }
  #lightbox figcaption span { color: var(--mute); font-size: 15px; }
  .lb-close, .lb-nav { background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 99px; width: 44px; height: 44px; font-size: 22px; cursor: pointer; justify-self: center; transition: background .2s; }
  .lb-close:hover, .lb-nav:hover { background: var(--red); }
  .lb-close { position: fixed; top: 18px; right: 18px; z-index: 2; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 700px) {
    #lightbox[open] { grid-template-columns: 1fr; padding: 0 12px; }
    #lightbox img { max-height: calc(100vh - 200px); max-height: calc(100dvh - 200px); }
    #lightbox figcaption b { font-size: 24px; }
    .lb-nav { position: fixed; bottom: 18px; z-index: 2; }
    .lb-nav.prev { left: 18px; } .lb-nav.next { right: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #lightbox[open] { animation: none; } }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dlg.querySelector('img')!;
  const place = dlg.querySelector('figcaption b')!;
  const date = dlg.querySelector('figcaption span')!;
  const count = dlg.querySelector('figcaption small')!;
  let items: HTMLElement[] = [];
  let i = 0;
  let opener: HTMLElement | null = null;

  const show = (n: number) => {
    i = (n + items.length) % items.length;
    const d = items[i].dataset;
    img.src = d.full!;
    img.alt = d.alt ?? '';
    place.textContent = d.place ?? '';
    date.textContent = d.date ?? '';
    count.textContent = `${i + 1} / ${items.length}`;
    // Warm the cache so the next and previous photos open instantly.
    for (const n of [i - 1, i + 1]) new Image().src = items[(n + items.length) % items.length].dataset.full!;
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-photo]');
    if (!t) return;
    // Only photos currently visible (filters hide some) take part in prev/next.
    items = [...document.querySelectorAll<HTMLElement>('[data-photo]')].filter((el) => !el.closest('[hidden]'));
    opener = t;
    show(items.indexOf(t));
    dlg.showModal();
  });

  dlg.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (act === 'close' || t === dlg) dlg.close();
    else if (act === 'prev') show(i - 1);
    else if (act === 'next') show(i + 1);
  });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  dlg.addEventListener('close', () => opener?.focus());

  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx > 0 ? i - 1 : i + 1);
  });
</script>
