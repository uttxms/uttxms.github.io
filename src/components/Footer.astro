---
import { site } from '../data/site';
const { links = false } = Astro.props;
---
<footer>
  {links && (
    <nav aria-label="Contact links">
      {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  )}
  <p>&copy; {new Date().getFullYear()} {site.name}</p>
</footer>

<style>
  footer { max-width: 1280px; margin: 40px auto 0; padding: 24px 8px 12px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; color: var(--mute); font-size: 15px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  a { text-decoration: none; transition: color .2s; }
  a:hover { color: var(--red-bright); }
  p { margin-left: auto; }
</style>
